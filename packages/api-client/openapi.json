  "info": {
    "title": "Kiro API",
    "description": "Backend API for the Kiro events platform",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "Str0ngPass"
          },
          "name": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "uk",
              "en"
            ],
            "default": "uk"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "uk",
              "en"
            ]
          }
        }
      },
      "CreateCategoryDto": {
        "type": "object",
        "properties": {
          "nameUk": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "description": "Parent category id — max tree depth is 2 (§16)."
          }
        },
        "required": [
          "nameUk"
        ]
      },
      "CreateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "title"
        ]
      },
      "UpdateEventDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "enum": [
              "uk",
              "en"
            ]
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "OFFLINE",
              "ONLINE"
            ]
          },
          "startsAt": {
            "type": "string"
          },
          "endsAt": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "cityId": {
            "type": "string"
          },
          "districtId": {
            "type": "string"
          },
          "addressText": {
            "type": "string"
          },
          "addressDetails": {
            "type": "object",
            "description": "Structured address components from Google Places (§60)."
          },
          "googlePlaceId": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "onlineUrl": {
            "type": "string"
          },
          "capacity": {
            "type": "number"
          },
          "minParticipants": {
            "type": "number"
          },
          "registrationDeadline": {
            "type": "string"
          },
          "approvalMode": {
            "type": "string",
            "enum": [
              "AUTO",
              "ORGANIZER_APPROVAL"
            ]
          },
          "ageRestriction": {
            "type": "number"
          },
          "rules": {
            "type": "string"
          },
          "priceType": {
            "type": "string",
            "enum": [
              "FREE",
              "PAID"
            ]
          },
          "price": {
            "type": "number"
          },
          "paymentUrl": {
            "type": "string"
          },
          "notifyParticipants": {
            "type": "boolean",
            "description": "Confirms the organizer wants participants notified of a significant change (§78). Required to be true when changing startsAt/address/onlineUrl on an already-published event."
          }
        }
      },
      "ReorderMediaDto": {
        "type": "object",
        "properties": {
          "mediaIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mediaIds"
        ]
      },
      "UpdateFocalPointDto": {
        "type": "object",
        "properties": {
          "focalX": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "focalY": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "focalX",
          "focalY"
        ]
      }
    }
  }
}