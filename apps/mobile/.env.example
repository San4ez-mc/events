# Copy to .env for local dev. Expo inlines EXPO_PUBLIC_* vars at build time.
# For `expo start --web`, localhost works since the browser and API share this host.
# For a real device via Expo Go, use this machine's LAN IP instead (e.g. http://192.168.1.4:3100).
EXPO_PUBLIC_API_URL=http://localhost:3100

# Public Google OAuth client IDs (not secrets) — set by eas.json for builds; only needed for local dev.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
