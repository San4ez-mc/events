// Kiro API — Prisma schema.
// Phase 0 scope: users, roles, auth support tables.
// Geography / categories / events land in Phase 1 (see TS spec §115).

generator client {
  provider = "prisma-client-js"
}

// `postgis` and `pg_trgm` are enabled on kiro_dev/kiro_test/kiro directly
// on the server (see docs/VPS_ACCESS.md), not through Prisma's
// `postgresqlExtensions` preview feature: that feature requires the DB role
// to be superuser to CREATE EXTENSION via a migration, which we deliberately
// don't grant `kiro`. Prisma models never reference native PostGIS geometry
// columns anyway (lat/lng stay plain Decimal) — postgis is only used via raw
// SQL (ST_Distance etc.) for proximity queries in later phases.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (kept 1:1 with packages/types/src/enums.ts — do not let these drift)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum SocialLinkType {
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  TIKTOK
  WEBSITE
  OTHER
}

enum LocationPermissionState {
  UNKNOWN
  GRANTED
  DENIED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String

  name      String?
  nickname  String?
  avatarUrl String?
  bio       String?

  phone           String?
  phoneVerifiedAt DateTime?

  locale String     @default("uk")
  status UserStatus @default(ACTIVE)
  role   UserRole   @default(USER)

  /// Set the first time this user creates an event (§10: organizer is not a role).
  organizerActivatedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  socialLinks        UserSocialLink[]
  preferences        UserPreferences?
  devices            UserDevice[]
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  auditLogs          AuditLog[]
  districtsCreated   District[]               @relation("DistrictCreator")
  categoriesCreated  Category[]               @relation("CategoryCreator")
  events             Event[]
  eventSeries        EventSeries[]

  @@map("users")
}

model UserSocialLink {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   SocialLinkType
  url    String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_social_links")
}

model UserPreferences {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  maxBudget Decimal? @db.Decimal(10, 2)

  allowPush                        Boolean @default(true)
  allowEmail                       Boolean @default(true)
  allowFriendActivityNotifications Boolean @default(true)
  allowSubscriptionNotifications   Boolean @default(true)
  allowEventReminderNotifications  Boolean @default(true)

  locationPermissionState LocationPermissionState @default(UNKNOWN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// Device push tokens (§41). Deactivated automatically on delivery failure.
model UserDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String
  lastSeenAt DateTime       @default(now())
  active     Boolean        @default(true)

  @@unique([userId, pushToken])
  @@index([userId])
  @@map("user_devices")
}

/// Refresh tokens are stored hashed, never in plaintext, and rotated on every
/// use (§9). A reused (already-rotated) token indicates theft and revokes the
/// whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  /// Groups all tokens descended from one login, so theft-detection can
  /// revoke the entire chain at once.
  familyId     String    @db.Uuid
  replacedById String?   @db.Uuid
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  createdByIp  String?
  userAgent    String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// System-wide
// ---------------------------------------------------------------------------

/// Config values that should be changeable without a deploy (§95).
model SystemSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Every admin/moderator mutation must create one of these (§75).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Geography (§14, §15, §37) — Ukraine only for now; country hierarchy is
// still explicit (countryCode on Region) so this isn't locked to one country.
// ---------------------------------------------------------------------------

enum RegionStatus {
  ACTIVE
  ARCHIVED
}

enum CityStatus {
  ACTIVE
  ARCHIVED
}

enum DistrictStatus {
  ACTIVE
  PENDING
  MERGED
  ARCHIVED
}

/// Where a district/category row came from — drives moderation UX (§37: user-
/// created local districts start PENDING and can be approved/merged by an admin).
enum GeoSource {
  SYSTEM
  USER_CREATED
  ADMIN_CREATED
}

model Region {
  id           String       @id @default(uuid()) @db.Uuid
  countryCode  String /// ISO 3166-1 alpha-2, e.g. "UA"
  nameUk       String
  nameEn       String
  externalCode String? /// e.g. KOATUU/KATOTTG code from the import source (§94)
  status       RegionStatus @default(ACTIVE)

  cities City[]

  @@unique([countryCode, nameUk])
  @@map("regions")
}

model City {
  id         String     @id @default(uuid()) @db.Uuid
  regionId   String     @db.Uuid
  region     Region     @relation(fields: [regionId], references: [id])
  nameUk     String
  nameEn     String
  slug       String     @unique
  latitude   Decimal    @db.Decimal(9, 6)
  longitude  Decimal    @db.Decimal(9, 6)
  population Int?
  status     CityStatus @default(ACTIVE)

  districts District[]
  events    Event[]

  @@index([regionId])
  @@map("cities")
}

model District {
  id     String @id @default(uuid()) @db.Uuid
  cityId String @db.Uuid
  city   City   @relation(fields: [cityId], references: [id])

  nameUk String
  nameEn String?

  status DistrictStatus @default(ACTIVE)
  source GeoSource      @default(SYSTEM)

  createdByUserId      String?    @db.Uuid
  createdByUser        User?      @relation("DistrictCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedIntoDistrictId String?    @db.Uuid
  mergedIntoDistrict   District?  @relation("DistrictMerge", fields: [mergedIntoDistrictId], references: [id])
  mergedFromDistricts  District[] @relation("DistrictMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@unique([cityId, nameUk])
  @@index([cityId])
  @@index([mergedIntoDistrictId])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// Categories (§16, §38) — max tree depth 2 (parent -> child), enforced in
// application logic (CategoriesService), not by the schema.
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  PENDING
  MERGED
  HIDDEN
  ARCHIVED
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  slug   String @unique
  nameUk String
  nameEn String

  icon String?

  status CategoryStatus @default(ACTIVE)
  source GeoSource      @default(SYSTEM)

  createdByUserId      String?    @db.Uuid
  createdByUser        User?      @relation("CategoryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedIntoCategoryId String?    @db.Uuid
  mergedIntoCategory   Category?  @relation("CategoryMerge", fields: [mergedIntoCategoryId], references: [id])
  mergedFromCategories Category[] @relation("CategoryMerge")

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@index([parentId])
  @@index([mergedIntoCategoryId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Events (§17-24, §29). Phase 1 scope: the event record itself, media, and
// simple (single-price) pricing. Deliberately NOT in this migration —
// they're later phases per §115 and would just be dead columns/tables today:
//   - event_price_options (multiple ticket tiers)      -> Phase 4
//   - event_registration_fields / registrations         -> Phase 4
//   - event_collaborators (co-organizers)                -> Phase 7
//   - event_faq_items, saves, subscriptions, reviews      -> Phase 6/7/8
// EventSeries is included now (empty of real UX) only because Event.seriesId
// is part of the core event record per §17 — Phase 7 builds recurrence UX on
// top of this FK, it doesn't need a schema change to do so.
// ---------------------------------------------------------------------------

enum RecurrenceType {
  DAILY
  EVERY_N_DAYS
  WEEKLY
  EVERY_N_WEEKS
  SPECIFIC_WEEKDAY
  SPECIFIC_DAY_OF_MONTH
  EVERY_N_MONTHS
}

/// Groups recurring event occurrences (§29). Each occurrence is a normal
/// `Event` row with its own id/registrations/stats — never one event record
/// with an array of dates.
model EventSeries {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  recurrenceType     RecurrenceType
  recurrenceRuleJson Json

  templateEventId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences Event[]

  @@index([ownerId])
  @@map("event_series")
}

enum EventStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventFormat {
  OFFLINE
  ONLINE
}

enum ApprovalMode {
  AUTO
  ORGANIZER_APPROVAL
}

enum EventPriceType {
  FREE
  PAID
}

enum Currency {
  UAH
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  seriesId String?      @db.Uuid
  series   EventSeries? @relation(fields: [seriesId], references: [id])

  slug String @unique

  /// Only `title` is required to create a draft — everything else below is
  /// only enforced at publish time (§69's "minimum required" list), not at
  /// the DB level, so the create-event wizard can save incrementally
  /// (§68: "Autosave draft") without every step being filled in yet.
  title       String
  description String? @db.Text

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id])

  language String @default("uk") /// §84 — event.language; user content isn't auto-translated

  status     EventStatus     @default(DRAFT)
  visibility EventVisibility @default(PUBLIC)
  format     EventFormat     @default(OFFLINE)

  startsAt DateTime?
  endsAt   DateTime?
  timezone String    @default("Europe/Kyiv")

  cityId     String?   @db.Uuid
  city       City?     @relation(fields: [cityId], references: [id])
  districtId String?   @db.Uuid
  district   District? @relation(fields: [districtId], references: [id])

  addressText    String?
  addressDetails Json?

  googlePlaceId String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)

  onlineUrl String?

  capacity        Int?
  minParticipants Int?

  registrationDeadline DateTime?

  approvalMode ApprovalMode @default(AUTO)

  /// Minimum age to attend, e.g. 18. Null = no restriction (UX doc §23, §41 — "усі/18+").
  ageRestriction Int?

  rules String? @db.Text

  /// Phase 1: simple single price. Multiple ticket tiers (event_price_options,
  /// §24) land in Phase 4 — this covers the "Безкоштовно / платно" step from
  /// the create-event wizard (UX §31 step 6) and §69's publish-validation
  /// requirement for a price/free state.
  priceType EventPriceType @default(FREE)
  price     Decimal?       @db.Decimal(10, 2)
  currency  Currency       @default(UAH)

  /// External payment link/instruction (§21) — Kiro is not a party to this payment.
  paymentUrl String?

  publishedAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media EventMedia[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([cityId])
  @@index([districtId])
  @@index([seriesId])
  @@index([status, visibility])
  @@map("events")
}

enum EventMediaType {
  IMAGE
  VIDEO
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Derivatives (display/thumbnail) are generated after upload (§23) — the
/// original is never destructively cropped, so the card's focal point can be
/// changed later without re-uploading.
model EventMedia {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type EventMediaType

  originalUrl  String
  displayUrl   String
  thumbnailUrl String

  width           Int?
  height          Int?
  durationSeconds Int?

  sortOrder Int @default(0)

  /// Crop focal point as a 0..1 fraction of the original image, so the
  /// vertical card preview can be regenerated without re-cropping (§23).
  focalX Decimal? @db.Decimal(4, 3)
  focalY Decimal? @db.Decimal(4, 3)

  moderationStatus MediaModerationStatus @default(APPROVED)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_media")
}
