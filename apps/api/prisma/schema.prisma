// Kiro API — Prisma schema.
// Phase 0 scope: users, roles, auth support tables.
// Geography / categories / events land in Phase 1 (see TS spec §115).

generator client {
  provider = "prisma-client-js"
}

// `postgis` and `pg_trgm` are enabled on kiro_dev/kiro_test/kiro directly
// on the server (see docs/VPS_ACCESS.md), not through Prisma's
// `postgresqlExtensions` preview feature: that feature requires the DB role
// to be superuser to CREATE EXTENSION via a migration, which we deliberately
// don't grant `kiro`. Prisma models never reference native PostGIS geometry
// columns anyway (lat/lng stay plain Decimal) — postgis is only used via raw
// SQL (ST_Distance etc.) for proximity queries in later phases.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (kept 1:1 with packages/types/src/enums.ts — do not let these drift)
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
  DELETED
}

enum SocialLinkType {
  INSTAGRAM
  TELEGRAM
  FACEBOOK
  TIKTOK
  WEBSITE
  OTHER
}

enum LocationPermissionState {
  UNKNOWN
  GRANTED
  DENIED
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid()) @db.Uuid

  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String

  name      String?
  nickname  String?
  avatarUrl String?
  bio       String?

  phone           String?
  phoneVerifiedAt DateTime?

  /// Optional. Used only to hide 18+ events from minors (UX §41) — never public unless the user opts in.
  birthDate DateTime? @db.Date

  locale String     @default("uk")
  status UserStatus @default(ACTIVE)
  role   UserRole   @default(USER)

  /// Set the first time this user creates an event (§10: organizer is not a role).
  organizerActivatedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  socialLinks              UserSocialLink[]
  preferences              UserPreferences?
  devices                  UserDevice[]
  refreshTokens            RefreshToken[]
  emailVerifications       EmailVerificationToken[]
  passwordResets           PasswordResetToken[]
  auditLogs                AuditLog[]
  districtsCreated         District[]               @relation("DistrictCreator")
  categoriesCreated        Category[]               @relation("CategoryCreator")
  events                   Event[]
  eventSeries              EventSeries[]
  listingCreditEntries     ListingCreditLedger[]
  moderationCasesResolved  ModerationCase[]
  eventInteractions        EventInteraction[]
  savedEvents              SavedEvent[]
  registrations            Registration[]
  notifications            Notification[]
  friendshipsSent          Friendship[]             @relation("FriendshipRequester")
  friendshipsReceived      Friendship[]             @relation("FriendshipAddressee")
  blocksMade               UserBlock[]              @relation("UserBlockBlocker")
  blocksReceived           UserBlock[]              @relation("UserBlockBlocked")
  privateNotesAuthored     PrivateUserNote[]        @relation("PrivateNoteAuthor")
  privateNotesAbout        PrivateUserNote[]        @relation("PrivateNoteTarget")
  subscriptions            Subscription[]           @relation("SubscriptionUser")
  subscribersAsOrganizer   Subscription[]           @relation("SubscriptionOrganizer")
  eventCollaborations      EventCollaborator[]
  eventInvitationsSent     EventInvitation[]        @relation("EventInvitationInviter")
  eventInvitationsReceived EventInvitation[]        @relation("EventInvitationInvitee")
  reviewsAuthored          EventReview[]
  chatMessages             EventChatMessage[]
  analyticsEvents          EventAnalyticsEvent[]
  platformPaymentOrders    PlatformPaymentOrder[]
  reportsFiled             Report[]                 @relation("ReportReporter")
  reportsAssigned          Report[]                 @relation("ReportAssignee")

  @@map("users")
}

model UserSocialLink {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @db.Uuid
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   SocialLinkType
  url    String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_social_links")
}

model UserPreferences {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  maxBudget Decimal? @db.Decimal(10, 2)

  /// Discovery filters (UX §7 — "filters persist in the profile but can be
  /// changed anytime"). These also feed the feed-ranking bonus (§58): they're
  /// the user's *default* interests, separate from the one-off query filters
  /// a single /discovery request can pass to narrow results further.
  preferredCityId String? @db.Uuid
  preferredCity   City?   @relation(fields: [preferredCityId], references: [id], onDelete: SetNull)

  preferredDistrictIds String[]     @default([])
  preferredCategoryIds String[]     @default([])
  preferredFormat      EventFormat?
  freeOnly             Boolean      @default(false)

  allowPush                        Boolean @default(true)
  allowEmail                       Boolean @default(true)
  allowFriendActivityNotifications Boolean @default(true)
  allowSubscriptionNotifications   Boolean @default(true)
  allowEventReminderNotifications  Boolean @default(true)

  /// §23 profile-privacy toggles. Per-event "show me as a participant" is a
  /// separate, already-built field (`Registration.showAsParticipant`) — not
  /// duplicated here. Friends-only visibility (vs. just public/hidden) isn't
  /// implemented yet; these are plain on/off.
  hideSocialLinks       Boolean @default(false)
  hideUpcomingEvents    Boolean @default(false)
  hideAttendanceHistory Boolean @default(false)

  locationPermissionState LocationPermissionState @default(UNKNOWN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// Device push tokens (§41). Deactivated automatically on delivery failure.
model UserDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String
  lastSeenAt DateTime       @default(now())
  active     Boolean        @default(true)

  @@unique([userId, pushToken])
  @@index([userId])
  @@map("user_devices")
}

/// Refresh tokens are stored hashed, never in plaintext, and rotated on every
/// use (§9). A reused (already-rotated) token indicates theft and revokes the
/// whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  /// Groups all tokens descended from one login, so theft-detection can
  /// revoke the entire chain at once.
  familyId     String    @db.Uuid
  replacedById String?   @db.Uuid
  revokedAt    DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  createdByIp  String?
  userAgent    String?

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// System-wide
// ---------------------------------------------------------------------------

/// Config values that should be changeable without a deploy (§95).
model SystemSetting {
  key       String   @id
  valueJson Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// Every admin/moderator mutation must create one of these (§75).
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Geography (§14, §15, §37) — Ukraine only for now; country hierarchy is
// still explicit (countryCode on Region) so this isn't locked to one country.
// ---------------------------------------------------------------------------

enum RegionStatus {
  ACTIVE
  ARCHIVED
}

enum CityStatus {
  ACTIVE
  ARCHIVED
}

enum DistrictStatus {
  ACTIVE
  PENDING
  MERGED
  ARCHIVED
}

/// Where a district/category row came from — drives moderation UX (§37: user-
/// created local districts start PENDING and can be approved/merged by an admin).
enum GeoSource {
  SYSTEM
  USER_CREATED
  ADMIN_CREATED
}

model Region {
  id           String       @id @default(uuid()) @db.Uuid
  countryCode  String /// ISO 3166-1 alpha-2, e.g. "UA"
  nameUk       String
  nameEn       String
  externalCode String? /// e.g. KOATUU/KATOTTG code from the import source (§94)
  status       RegionStatus @default(ACTIVE)

  cities City[]

  @@unique([countryCode, nameUk])
  @@map("regions")
}

model City {
  id         String     @id @default(uuid()) @db.Uuid
  regionId   String     @db.Uuid
  region     Region     @relation(fields: [regionId], references: [id])
  nameUk     String
  nameEn     String
  slug       String     @unique
  latitude   Decimal    @db.Decimal(9, 6)
  longitude  Decimal    @db.Decimal(9, 6)
  population Int?
  status     CityStatus @default(ACTIVE)

  districts   District[]
  events      Event[]
  preferredBy UserPreferences[]

  @@index([regionId])
  @@map("cities")
}

model District {
  id     String @id @default(uuid()) @db.Uuid
  cityId String @db.Uuid
  city   City   @relation(fields: [cityId], references: [id])

  nameUk String
  nameEn String?

  status DistrictStatus @default(ACTIVE)
  source GeoSource      @default(SYSTEM)

  createdByUserId      String?    @db.Uuid
  createdByUser        User?      @relation("DistrictCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedIntoDistrictId String?    @db.Uuid
  mergedIntoDistrict   District?  @relation("DistrictMerge", fields: [mergedIntoDistrictId], references: [id])
  mergedFromDistricts  District[] @relation("DistrictMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@unique([cityId, nameUk])
  @@index([cityId])
  @@index([mergedIntoDistrictId])
  @@map("districts")
}

// ---------------------------------------------------------------------------
// Categories (§16, §38) — max tree depth 2 (parent -> child), enforced in
// application logic (CategoriesService), not by the schema.
// ---------------------------------------------------------------------------

enum CategoryStatus {
  ACTIVE
  PENDING
  MERGED
  HIDDEN
  ARCHIVED
}

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  slug   String @unique
  nameUk String
  nameEn String

  icon String?

  status CategoryStatus @default(ACTIVE)
  source GeoSource      @default(SYSTEM)

  createdByUserId      String?    @db.Uuid
  createdByUser        User?      @relation("CategoryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  mergedIntoCategoryId String?    @db.Uuid
  mergedIntoCategory   Category?  @relation("CategoryMerge", fields: [mergedIntoCategoryId], references: [id])
  mergedFromCategories Category[] @relation("CategoryMerge")

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        Event[]
  subscriptions Subscription[]

  @@index([parentId])
  @@index([mergedIntoCategoryId])
  @@map("categories")
}

// ---------------------------------------------------------------------------
// Events (§17-24, §29). Phase 1 scope: the event record itself, media, and
// simple (single-price) pricing. Deliberately NOT in this migration —
// they're later phases per §115 and would just be dead columns/tables today:
//   - event_price_options (multiple ticket tiers)      -> Phase 4
//   - event_registration_fields / registrations         -> Phase 4
//   - event_collaborators (co-organizers)                -> Phase 7
//   - event_faq_items, saves, subscriptions, reviews      -> Phase 6/7/8
// EventSeries is included now (empty of real UX) only because Event.seriesId
// is part of the core event record per §17 — Phase 7 builds recurrence UX on
// top of this FK, it doesn't need a schema change to do so.
// ---------------------------------------------------------------------------

enum RecurrenceType {
  DAILY
  EVERY_N_DAYS
  WEEKLY
  EVERY_N_WEEKS
  SPECIFIC_WEEKDAY
  SPECIFIC_DAY_OF_MONTH
  EVERY_N_MONTHS
}

/// Groups recurring event occurrences (§29). Each occurrence is a normal
/// `Event` row with its own id/registrations/stats — never one event record
/// with an array of dates.
model EventSeries {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  recurrenceType     RecurrenceType
  recurrenceRuleJson Json

  templateEventId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences Event[]

  @@index([ownerId])
  @@map("event_series")
}

enum EventStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  REJECTED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum EventFormat {
  OFFLINE
  ONLINE
}

enum ApprovalMode {
  AUTO
  ORGANIZER_APPROVAL
}

enum EventPriceType {
  FREE
  PAID
}

enum Currency {
  UAH
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  ownerId String @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  seriesId String?      @db.Uuid
  series   EventSeries? @relation(fields: [seriesId], references: [id])

  slug String @unique

  /// Only `title` is required to create a draft — everything else below is
  /// only enforced at publish time (§69's "minimum required" list), not at
  /// the DB level, so the create-event wizard can save incrementally
  /// (§68: "Autosave draft") without every step being filled in yet.
  title       String
  description String? @db.Text

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id])

  language String @default("uk") /// §84 — event.language; user content isn't auto-translated

  status     EventStatus     @default(DRAFT)
  visibility EventVisibility @default(PUBLIC)
  format     EventFormat     @default(OFFLINE)

  startsAt DateTime?
  endsAt   DateTime?
  timezone String    @default("Europe/Kyiv")

  cityId     String?   @db.Uuid
  city       City?     @relation(fields: [cityId], references: [id])
  districtId String?   @db.Uuid
  district   District? @relation(fields: [districtId], references: [id])

  addressText    String?
  addressDetails Json?

  googlePlaceId String?
  latitude      Decimal? @db.Decimal(9, 6)
  longitude     Decimal? @db.Decimal(9, 6)

  onlineUrl String?

  capacity        Int?
  minParticipants Int?

  registrationDeadline DateTime?

  approvalMode ApprovalMode @default(AUTO)

  /// Minimum age to attend, e.g. 18. Null = no restriction (UX doc §23, §41 — "усі/18+").
  ageRestriction Int?

  rules String? @db.Text

  /// Simple single price. Multiple ticket tiers (event_price_options, §24)
  /// are NOT in Phase 4's acceptance checklist (custom questions/approval/
  /// capacity/payment-link/manual-confirmation/cancellations only) — still
  /// deferred, this covers the "Безкоштовно / платно" step from the
  /// create-event wizard (UX §31 step 6) and §69's publish-validation
  /// requirement for a price/free state.
  priceType EventPriceType @default(FREE)
  price     Decimal?       @db.Decimal(10, 2)
  currency  Currency       @default(UAH)

  /// External payment link/instruction (§21) — Kiro is not a party to this payment.
  paymentUrl String?

  publishedAt        DateTime?
  cancelledAt        DateTime?
  /// Optional organizer-given reason (§79), shown to registrants in the (Phase 5) cancellation notification.
  cancellationReason String?
  completedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media              EventMedia[]
  interactions       EventInteraction[]
  savedBy            SavedEvent[]
  registrationFields RegistrationField[]
  faqItems           EventFaqItem[]
  registrations      Registration[]
  subscriptions      Subscription[]
  privateNotes       PrivateUserNote[]
  collaborators      EventCollaborator[]
  invitations        EventInvitation[]
  reviews            EventReview[]
  chatMessages       EventChatMessage[]
  analyticsEvents    EventAnalyticsEvent[]
  dailyStats         EventDailyStat[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([cityId])
  @@index([districtId])
  @@index([seriesId])
  @@index([status, visibility])
  @@map("events")
}

enum EventMediaType {
  IMAGE
  VIDEO
}

enum MediaModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Derivatives (display/thumbnail) are generated after upload (§23) — the
/// original is never destructively cropped, so the card's focal point can be
/// changed later without re-uploading.
model EventMedia {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  type EventMediaType

  originalUrl  String
  displayUrl   String
  thumbnailUrl String

  width           Int?
  height          Int?
  durationSeconds Int?

  sortOrder Int @default(0)

  /// Crop focal point as a 0..1 fraction of the original image, so the
  /// vertical card preview can be regenerated without re-cropping (§23).
  focalX Decimal? @db.Decimal(4, 3)
  focalY Decimal? @db.Decimal(4, 3)

  moderationStatus MediaModerationStatus @default(APPROVED)

  createdAt DateTime @default(now())

  @@index([eventId])
  @@map("event_media")
}

// ---------------------------------------------------------------------------
// Listing credits & moderation (§48-55, Phase 2). Credit packages exist here
// (needed by the free-grant flow and to show pricing); purchasing them is
// Phase 9's PlatformPaymentOrder, defined further below.
// ---------------------------------------------------------------------------

enum ListingCreditType {
  GRANT
  PURCHASE
  EVENT_PUBLICATION
  REFUND
  ADMIN_ADJUSTMENT
  PROMO
}

/// Ledger, not a balance column (§48) — balance is always SUM(creditsDelta).
/// Never UPDATE or DELETE a row here; every change is a new entry.
model ListingCreditLedger {
  id     String            @id @default(uuid()) @db.Uuid
  userId String            @db.Uuid
  user   User              @relation(fields: [userId], references: [id])
  type   ListingCreditType

  creditsDelta Int

  /// e.g. "EVENT" + the event id, or "FREE_ORGANIZER_BONUS" + the user id —
  /// used as an idempotency key so a grant/debit can't be double-applied.
  sourceType String
  sourceId   String?

  description String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("listing_credit_ledger")
}

model CreditPackage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  credits   Int
  price     Decimal  @db.Decimal(10, 2)
  currency  Currency @default(UAH)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)

  paymentOrders PlatformPaymentOrder[]

  @@map("credit_packages")
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ModerationReasonCode {
  SENSITIVE_KEYWORDS
  WAR_RELATED
  ADULT_CONTENT
  USER_REPORTED
  MANUAL_REVIEW
}

model ModerationCase {
  id         String @id @default(uuid()) @db.Uuid
  targetType String
  targetId   String

  reasonCode ModerationReasonCode
  details    String?

  status ModerationStatus @default(PENDING)

  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  resolvedByAdminId String?   @db.Uuid
  resolvedByAdmin   User?     @relation(fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([status])
  @@map("moderation_cases")
}

enum ReportTargetType {
  EVENT
  USER
  REVIEW
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

/// §39 — a user flagging an event/user/review for admin attention. Distinct
/// from `ModerationCase`, which is the automatic pre-publish content scan
/// (§53-55); a report is always human-initiated and always resolved by hand
/// (Phase 10's `/admin/reports`).
model Report {
  id         String @id @default(uuid()) @db.Uuid
  reporterId String @db.Uuid
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  targetId   String

  reason      String
  description String?

  status ReportStatus @default(OPEN)

  assignedAdminId String? @db.Uuid
  assignedAdmin   User?   @relation("ReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Discovery (§56-59, Phase 3): swipe feed, search, saved events.
// ---------------------------------------------------------------------------

/// §59's `user_event_interactions`. Value is `UserEventInteraction` in
/// packages/types/src/enums.ts — named `InteractionType` here (not
/// `UserEventInteraction`) purely to avoid a same-named Prisma-generated
/// type colliding with the `@kiro/types` enum of the same name.
enum InteractionType {
  PASS
  OPEN
}

/// Append-only log, not a toggle: every swipe/tap is its own row so the
/// pass-cooldown window (§59, `feedPassCooldownDays`) can look at *when* the
/// last PASS happened, not just whether one ever did.
model EventInteraction {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  interaction InteractionType

  createdAt DateTime @default(now())

  @@index([userId, interaction, createdAt])
  @@index([eventId])
  @@map("user_event_interactions")
}

/// UX §5 — "Save is not a registration." One row per user+event; saving
/// twice is a no-op (unique constraint), unsaving deletes the row.
model SavedEvent {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId, createdAt])
  @@map("saved_events")
}

// ---------------------------------------------------------------------------
// Registrations (§25-28, §78-79, Phase 4). Ticket tiers (event_price_options)
// stay deferred — see the note on Event.priceType above.
// ---------------------------------------------------------------------------

enum RegistrationFieldType {
  TEXT
  TEXTAREA
  NUMBER
  PHONE
  EMAIL
  SELECT
  MULTISELECT
  CHECKBOX
  DATE
}

/// §25's `event_registration_fields` — organizer-defined custom questions on
/// top of the built-in name/phone/email (which come from the User profile).
model RegistrationField {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  label       String
  type        RegistrationFieldType
  required    Boolean               @default(false)
  /// Option labels for SELECT/MULTISELECT, e.g. ["Beginner","Intermediate","Advanced"].
  optionsJson Json?
  sortOrder   Int                   @default(0)

  createdAt DateTime @default(now())

  answers RegistrationAnswer[]

  @@index([eventId])
  @@map("event_registration_fields")
}

enum RegistrationStatus {
  PENDING
  REGISTERED
  PAYMENT_PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  ATTENDED
  NO_SHOW
  WAITLISTED
}

/// §26's `event_registrations`. The state machine (§27) is driven by
/// `Event.approvalMode` + `Event.priceType` — see RegistrationsService.
model Registration {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status RegistrationStatus @default(PENDING)

  /// UX §83 — opt-in, default false: shown in the event page's public
  /// attendee-preview list only if the registrant explicitly agreed.
  showAsParticipant Boolean @default(false)

  registeredAt DateTime  @default(now())
  approvedAt   DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?

  paymentClickedAt   DateTime?
  paymentConfirmedAt DateTime?

  /// Visible to the organizer only, never the registrant (§83).
  organizerPrivateNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers RegistrationAnswer[]

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId])
  @@map("event_registrations")
}

/// §28's `event_registration_answers` — one row per field, not one big blob,
/// so answers stay individually queryable/exportable per the spec's explicit
/// warning against collapsing a whole form into unstructured JSON.
model RegistrationAnswer {
  id             String            @id @default(uuid()) @db.Uuid
  registrationId String            @db.Uuid
  registration   Registration      @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  fieldId        String            @db.Uuid
  field          RegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  valueJson Json

  createdAt DateTime @default(now())

  @@unique([registrationId, fieldId])
  @@map("event_registration_answers")
}

// ---------------------------------------------------------------------------
// Notifications (§40-44, Phase 5).
// ---------------------------------------------------------------------------

enum NotificationType {
  REGISTRATION_RECEIVED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  EVENT_CHANGED
  EVENT_CANCELLED
  EVENT_REMINDER_24H
  EVENT_REMINDER_1H
  EVENT_MIN_PARTICIPANTS_WARNING
  ORGANIZER_NEW_EVENT
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_EVENT_REGISTERED
  WAITLIST_SPOT_OPENED
  REVIEW_REQUEST
  CATEGORY_MERGED
  DISTRICT_MERGED
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// §40's `notifications` — one row per user per event, independent of how
/// many channels it goes out on (that's `NotificationDelivery`).
model Notification {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  body        String
  /// Structured context (e.g. {eventId, registrationId}) — lets the client
  /// deep-link, and lets jobs dedup ("has this reminder already fired?")
  /// without a separate tracking table.
  payloadJson Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// §40's `notification_deliveries` — per-channel delivery attempt/outcome.
model NotificationDelivery {
  id             String       @id @default(uuid()) @db.Uuid
  notificationId String       @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  status  NotificationDeliveryStatus @default(PENDING)

  providerMessageId String?
  sentAt            DateTime?
  failedAt          DateTime?
  error             String?

  createdAt DateTime @default(now())

  @@index([notificationId])
  @@map("notification_deliveries")
}

// ---------------------------------------------------------------------------
// Social (§33-36, Phase 6): friends, blocks, private notes, subscriptions.
// ---------------------------------------------------------------------------

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// §34's `friendships`. A unique *unordered* pair isn't expressible as a
/// plain DB constraint (A->B and B->A are different rows) — enforced in
/// FriendsService instead, which checks both directions before creating one.
model Friendship {
  id          String @id @default(uuid()) @db.Uuid
  requesterId String @db.Uuid
  requester   User   @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String @db.Uuid
  addressee   User   @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  status FriendshipStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

/// §35's `user_blocks`. Blocked users can't friend-request the blocker,
/// their activity is hidden from them, and (best-effort) their events are
/// excluded from the blocker's recommendations.
model UserBlock {
  id            String @id @default(uuid()) @db.Uuid
  blockerId     String @db.Uuid
  blocker       User   @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUserId String @db.Uuid
  blockedUser   User   @relation("UserBlockBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockedUserId])
  @@map("user_blocks")
}

/// §36's `private_user_notes`. Never returned to the target user — only the
/// author (typically an organizer) can ever read their own notes.
model PrivateUserNote {
  id           String @id @default(uuid()) @db.Uuid
  authorUserId String @db.Uuid
  author       User   @relation("PrivateNoteAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  targetUserId String @db.Uuid
  target       User   @relation("PrivateNoteTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  eventId String? @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  note String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorUserId, targetUserId])
  @@map("private_user_notes")
}

enum SubscriptionScope {
  EVENT
  ORGANIZER_CATEGORY
  ORGANIZER_ALL
}

/// §33's `subscriptions`. "Follow" an organizer within one category (not a
/// platform-wide category subscription) or all of an organizer's events.
/// The "Слідкувати" button on an event page creates an EVENT subscription
/// plus an ORGANIZER_CATEGORY one if it doesn't already exist.
model Subscription {
  id     String            @id @default(uuid()) @db.Uuid
  userId String            @db.Uuid
  user   User              @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  scope  SubscriptionScope

  eventId String? @db.Uuid
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  organizerId String? @db.Uuid
  organizer   User?   @relation("SubscriptionOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scope])
  @@index([organizerId, scope])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------
// Organizer tools (§29-30, §70-71, Phase 7): co-organizers, recurring
// events, duplicating an event, inviting past participants.
// ---------------------------------------------------------------------------

enum CollaboratorRole {
  OWNER
  MANAGER
}

enum CollaboratorPermission {
  EDIT_EVENT
  MANAGE_REGISTRATIONS
  MANAGE_PAYMENTS
  SEND_NOTIFICATIONS
  MANAGE_CHAT
  INVITE_PREVIOUS_PARTICIPANTS
  VIEW_ANALYTICS
}

/// §30's `event_collaborators`. The owner ("Owner один") is `Event.ownerId`
/// itself, never a row here — this table only holds MANAGER collaborators
/// ("Managers декілька"), each with its own granular permission set.
model EventCollaborator {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        CollaboratorRole         @default(MANAGER)
  permissions CollaboratorPermission[]

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_collaborators")
}

enum EventInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

/// §71's `event_invitations` — organizer invites someone who registered for
/// one of their past events to a new one.
model EventInvitation {
  id            String @id @default(uuid()) @db.Uuid
  eventId       String @db.Uuid
  event         Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterUserId String @db.Uuid
  inviter       User   @relation("EventInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  inviteeUserId String @db.Uuid
  invitee       User   @relation("EventInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  status EventInvitationStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([eventId, inviteeUserId])
  @@index([inviteeUserId, status])
  @@map("event_invitations")
}

// ---------------------------------------------------------------------------
// Reviews (§37-38, §80-81, Phase 8): post-event review, organizer rating.
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PUBLISHED
  HIDDEN
  REMOVED
}

/// §37's `event_reviews`. Only allowed once the event is COMPLETED and the
/// author had an eligible registration (§81) — enforced in ReviewsService,
/// not the DB. The organizer's aggregate rating (§38) is deliberately NOT
/// stored here or in a cache table: it's computed on read from PUBLISHED
/// rows, the same on-demand-over-cached trade-off already made for
/// EventsService.getStats (Phase 7) — simpler, never stale, and cheap enough
/// at this scale (one AVG+COUNT query).
model EventReview {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @db.Uuid
  event        Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorUserId String @db.Uuid
  author       User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  rating Int /// 1..5, enforced in ReviewsService
  text   String? @db.Text

  status ReviewStatus @default(PUBLISHED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, authorUserId])
  @@index([eventId, status])
  @@map("event_reviews")
}

// ---------------------------------------------------------------------------
// Kiro payments (§51, Phase 9): buying listing-credit packages with real
// money. Deliberately a separate system from event-ticket payments
// (Event.paymentUrl, Registration.paymentClickedAt/paymentConfirmedAt) —
// Kiro is never a party to those, only to this.
// ---------------------------------------------------------------------------

enum PaymentProvider {
  WAYFORPAY
  MONO
  MANUAL_IBAN
}

enum PlatformPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// §51's `platform_payment_orders`. Crediting the ledger on PAID happens in
/// the same transaction as this status flip (PaymentsService.markPaid) —
/// idempotent via a `listing_credit_ledger` row keyed on sourceId=order.id,
/// same pattern as the event-publication debit and the free-credit grant.
model PlatformPaymentOrder {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  packageId String        @db.Uuid
  package   CreditPackage @relation(fields: [packageId], references: [id])

  provider PaymentProvider
  amount   Decimal               @db.Decimal(10, 2)
  currency Currency              @default(UAH)
  status   PlatformPaymentStatus @default(PENDING)

  /// The provider's own id/reference for this payment (WayForPay's
  /// orderReference echo, Mono's invoiceId) — set once known, used to match
  /// an incoming webhook back to this order.
  providerReference String?

  createdAt DateTime  @default(now())
  paidAt    DateTime?

  @@index([userId])
  @@index([provider, providerReference])
  @@map("platform_payment_orders")
}

// ---------------------------------------------------------------------------
// Event chat (UX §28): a simple group chat per event for confirmed
// participants and organizers. No DMs in the MVP.
// ---------------------------------------------------------------------------

model EventChatMessage {
  id       String @id @default(uuid()) @db.Uuid
  eventId  String @db.Uuid
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId String @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@map("event_chat_messages")
}

// ---------------------------------------------------------------------------
// Event analytics (§45-47, UX §35): an append-only action log plus a daily
// aggregate so the organizer dashboard never COUNTs raw rows.
// ---------------------------------------------------------------------------

enum AnalyticsAction {
  IMPRESSION
  VIEW
  SAVE
  UNSAVE
  SHARE
  REGISTRATION_STARTED
  REGISTERED
  CANCELLED
  PAYMENT_LINK_CLICK
  SUBSCRIBED
}

/// UX §35 traffic sources: Threads / Direct link / Search / Swipe / Profile / Other.
enum TrafficSource {
  SWIPE
  SEARCH
  DIRECT
  PROFILE
  THREADS
  OTHER
}

model EventAnalyticsEvent {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?

  action       AnalyticsAction
  source       TrafficSource?
  metadataJson Json?

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([eventId, action])
  @@map("event_analytics_events")
}

model EventDailyStat {
  eventId String   @db.Uuid
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date

  impressions        Int @default(0)
  views              Int @default(0)
  saves              Int @default(0)
  shares             Int @default(0)
  registrationStarts Int @default(0)
  registrations      Int @default(0)
  confirmed          Int @default(0)
  cancellations      Int @default(0)
  paymentClicks      Int @default(0)

  /// View counts per traffic source for the day, e.g. {"SWIPE": 12, "DIRECT": 3}.
  viewsBySource Json @default("{}")

  @@id([eventId, date])
  @@map("event_daily_stats")
}

/// §20 — organizer-authored FAQ shown on the event page (question + answer, ordered).
model EventFaqItem {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  question  String
  answer    String @db.Text
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, sortOrder])
  @@map("event_faq_items")
}
