# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3100

# Local dev: DB lives on the VPS, reached through an SSH tunnel.
# Run `pnpm db:tunnel` (from repo root) in a separate terminal first, then:
DATABASE_URL=postgresql://kiro:CHANGE_ME@localhost:5433/kiro_dev

JWT_ACCESS_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

APP_URL=http://localhost:3000
API_URL=http://localhost:3100

CORS_ORIGINS=http://localhost:3000,http://localhost:8081

GOOGLE_MAPS_API_KEY=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kiro-dev
S3_REGION=us-east-1
S3_PUBLIC_URL=

INITIAL_SUPERADMIN_EMAIL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kiro <no-reply@kiro.local>

LOG_LEVEL=debug
