{
  "name": "kiro",
  "private": true,
  "version": "0.0.1",
  "description": "Kiro — платформа пошуку подій та розваг (iOS, Android, web, admin) на єдиному backend API.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rimraf node_modules",
    "db:tunnel": "node infrastructure/scripts/db-tunnel.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
